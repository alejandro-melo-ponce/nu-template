% Nazarbayev University (SSH) color palette for Gemini posters
% https://github.com/alejandro-melo-ponce/nu-template/tree/nu-customization
% ====================
% Definitions
% ====================
\definecolor{nugold}{RGB}{245, 183, 49}        % NU brand gold — header/footer bg
\definecolor{darkgold}{RGB}{184, 134, 11}      % DarkGoldenrod — block titles, bullets, accents
\definecolor{deepbrown}{RGB}{59, 42, 15}       % Warm near-black — headline text, headings
\definecolor{lightgold}{RGB}{254, 240, 213}    % Light gold — alert/highlighted block bg
\definecolor{warmcream}{RGB}{255, 249, 238}    % Warm cream — example block bg
% ====================
% Theme
% ====================
% Basic colors
\setbeamercolor{palette primary}{fg=black,bg=white}
\setbeamercolor{palette secondary}{fg=black,bg=white}
\setbeamercolor{palette tertiary}{bg=black,fg=white}
\setbeamercolor{palette quaternary}{fg=black,bg=white}
\setbeamercolor{structure}{fg=deepbrown}
% Headline
\setbeamercolor{headline}{fg=deepbrown,bg=nugold}
\setbeamercolor{headline rule}{bg=darkgold}
% Block
\setbeamercolor{block title}{fg=darkgold,bg=white}
\setbeamercolor{block separator}{bg=darkgold}
\setbeamercolor{block body}{fg=black,bg=white}
% Alert Block
\setbeamercolor{block title alerted}{fg=darkgold,bg=lightgold}
\setbeamercolor{block separator alerted}{bg=darkgold}
\setbeamercolor{block body alerted}{fg=black,bg=lightgold}
% Example Block
\setbeamercolor{block title example}{fg=darkgold,bg=warmcream}
\setbeamercolor{block separator example}{bg=darkgold}
\setbeamercolor{block body example}{fg=black,bg=warmcream}
% Heading
\setbeamercolor{heading}{fg=deepbrown}
% Itemize
\setbeamercolor{item}{fg=darkgold}
% Bibliography
\setbeamercolor{bibliography item}{fg=black}
\setbeamercolor{bibliography entry author}{fg=black}
\setbeamercolor{bibliography entry title}{fg=black}
\setbeamercolor{bibliography entry location}{fg=black}
\setbeamercolor{bibliography entry note}{fg=black}
% Footnote
\setbeamercolor{footline}{fg=deepbrown,bg=nugold}